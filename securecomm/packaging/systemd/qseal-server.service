[Unit]
Description=QSEAL Quantum-Secure Server Daemon
Documentation=https://github.com/qseal/qseal
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/qseal server start --config /etc/qseal/server.json
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# Security and Isolation Sandboxing
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
ReadWritePaths=/etc/qseal /var/lib/qseal /var/log/qseal

[Install]
WantedBy=multi-user.target

