# ==============================================================================
# QSEAL (Quantum-Secure Enterprise Access & Link) - Production .gitignore
# ==============================================================================

# Compiled Object Files and Static/Shared Libraries
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.d
*.ko
*.elf

# Build Directories and Output Trees
build/
bin/
liboqs/build*/
qseal/bin/
qseal/packaging/debian/obj_*/
qseal/packaging/debian/staging*/
qseal/packaging/debian/*.deb
*.deb

# Executable Binaries (Keep source files)
**/server
**/server_rx
**/server_tx
**/client
**/client_broadcast
**/bench_pqc
**/benchpqc
**/bench_crypto
**/bench_hybrid
**/bench_nclient
**/bench_aead
**/hybrid_client
**/hybrid_server
/bench_pqc
/benchpqc
**/bin/qseal
**/bin/qseal-server
**/bin/qseal-client
**/bin/qseal_arm64

# Test Executables (Ignore compiled test binaries, keep *.c and *.h source files)
**/tests/**/test_*
**/tests/test_*
!**/tests/**/test_*.c
!**/tests/**/test_*.h
!**/tests/test_*.c
!**/tests/test_*.h
**/tests/test_suite
!**/tests/test_suite.c

# Security Lab Binaries and Dynamic Output Artifacts
security_lab/security_lab
security_lab/results/run_*
security_lab/results/latest
security_lab/results/*.log
security_lab/results/*.csv
security_lab/results/*.json
security_lab/results/*.md
!security_lab/results/.gitkeep

# Runtime Artifacts, Sockets, Status and Endpoint Files
*.sock
*.pid
*.status
*.endpoint
server_endpoint.info
**/server_endpoint.info
/tmp/qseal*
/tmp/*_rx.sock
/tmp/*_tx.sock

# Runtime Cryptographic Keys and Databases (Do not commit private keys)
*.key
*.pub
*.db
*.trust

# Logs and Core Dumps
*.log
core
core.*

# Documentation (generated or manual local drafts)
documentation/

# IDE, OS, and Temporary Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
scratch/
tmp/
